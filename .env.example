# --- Discord ---
DISCORD_TOKEN=din-bot-token-her
DISCORD_CHANNEL_ID=123456789012345678

# --- Kilde ---
# tcp  = forbind direkte til en companion-node (fx meshcomod på Heltec V4, port 5000)
# mqtt = lyt på en observer via MQTT-broker
MESH_SOURCE=tcp
MESH_HOST=192.168.1.60
MESH_PORT=5000

# --- MQTT (kun når MESH_SOURCE=mqtt) ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CLIENT_ID=meshcore-discord-bot
# Kommasepareret liste. Fx meshcore/CPH/+/packets
MQTT_TOPICS=meshcore/#

# --- Adfærd ---
# Pakketyper der postes: GRP_TXT, ADVERT, TXT_MSG, ... eller * for alt
POST_TYPES=GRP_TXT
# Kanalnøgler til dekryptering: "public" eller "navn=hex16bytes", kommasepareret
CHANNEL_KEYS=public
DEDUPE_SECONDS=60
# Post også MQTT-beskeder uden rå pakke (status m.m.) – godt til debugging
POST_RAW=false
LOG_LEVEL=INFO
